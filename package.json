{
  "name": "space-invaders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "平台无关的贡献日历像素动画生成器（零运行时依赖）",
  "license": "MIT",
  "author": "h1s97x",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "docs": "npm run build && node dist/scripts/docs.js",
    "docs:check": "node dist/scripts/docs.js --check",
    "check": "npm run typecheck && npm test && npm run docs:check",
    "golden": "npm run build && node dist/scripts/golden.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
